# ======================================
# AI Sequence Generator — .env.example
# ======================================

# Google / Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Groq (free: console.groq.com — 30 RPM, sub-200ms latency)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Qdrant  (leave blank to run without RAG)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=company_knowledge

# Database
DATABASE_URL=sqlite+aiosqlite:///./sequence_generator.db

# App
APP_ENV=development
LOG_LEVEL=INFO

# Timeouts & Retries
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Scoring
MIN_SCORE_THRESHOLD=7.0
MAX_REVISION_CYCLES=3
